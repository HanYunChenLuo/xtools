{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xperf-gui",
  "version": "0.1.5",
  "identifier": "com.xtools.xperf-gui",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XPerformance Monitor",
        "width": 1400,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
